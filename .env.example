# AgentMail Environment Configuration
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!

# Gmail address to send from
# Recommendation: Use a dedicated account for your agent (e.g., myproject-agent@gmail.com)
GMAIL_USER=your-agent@gmail.com

# App Password (not your regular Gmail password!)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on the account
# Enter without spaces (16 characters)
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
